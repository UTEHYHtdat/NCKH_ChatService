# Environment Variables — ChatService
# Copy file này thành .env và điền giá trị thật vào

# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/nckh_db

# ─── JWT ──────────────────────────────────────────────────────────────────
# PHẢI giống với JWT_SECRET trong AuthService để verify token đúng
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────────────────────
PORT=8006
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────
# URL của frontend (React app)
FRONTEND_URL=http://localhost:3000

# ─── Internal Service Key ─────────────────────────────────────────────────
# Key dùng cho service-to-service calls (ThesisService → ChatService)
# PHẢI giống với INTERNAL_API_KEY trong ThesisService .env
INTERNAL_API_KEY=your-internal-secret-key-here

# ─── Mã hóa tin nhắn (AES-256) ────────────────────────────────────────────
# Key dùng để mã hóa/giải mã nội dung tin nhắn trong DB
# Nên dùng chuỗi ngẫu nhiên dài ít nhất 32 ký tự
AES_SECRET_KEY=your-aes-secret-key-min-32-chars-here

